          "name": "2. Get List My Events (GET /mine)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/manage/events/mine",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manage", "events", "mine"]
