    {
      "name": "03. Host Events Lifecycle & Wizard",
      "item": [
        {
          "name": "1. Inisiasi Draft Acara (POST /draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('eventId', res.data.id);",
                  "    pm.collectionVariables.set('eventSlug', res.data.slug);",
                  "    console.log('Event ID disimpan:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Wedding of Andi & Siti\",\n  \"slug\": \"{{eventSlug}}\",\n  \"timeZone\": \"Asia/Jakarta\",\n  \"templateId\": \"minimalist-elegance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manage/events/draft",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manage", "events", "draft"]
            }
          }
        },
