              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status Code adalah 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error code SLUG_IMMUTABLE', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.error.code).to.eql('SLUG_IMMUTABLE');",
