    },
    {
      "name": "04. Cloudflare R2 Media Upload",
      "item": [
        {
          "name": "1. Request Presigned PUT URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('presignedUploadUrl', res.data.uploadUrl);",
                  "    pm.collectionVariables.set('uploadedFileKey', res.data.fileKey);",
                  "    pm.collectionVariables.set('uploadedMimeType', res.data.mimeType);",
                  "    console.log('Presigned URL berhasil didapatkan');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"mediaType\": \"photo\",\n  \"fileName\": \"foto-prewed.webp\",\n  \"fileSize\": 250000,\n  \"mimeType\": \"image/webp\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manage/media/presign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manage", "media", "presign"]
            }
          }
        },
        {
          "name": "2. Direct Upload PUT ke Cloudflare R2",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{uploadedMimeType}}",
                "description": "WAJIB IDENTIK DENGAN MIMETYPE PRESIGN (Jebakan 3 AGENTS.md)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "dummy-webp-binary-content-for-testing"
            },
            "url": {
              "raw": "{{presignedUploadUrl}}",
              "host": ["{{presignedUploadUrl}}"]
            }
          }
        },
        {
          "name": "3. Confirm Upload & Simpan ke DB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('mediaId', res.data.id);",
                  "    console.log('Media ID disimpan:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"fileKey\": \"{{uploadedFileKey}}\",\n  \"mediaType\": \"photo\",\n  \"mimeType\": \"{{uploadedMimeType}}\",\n  \"fileSize\": 250000,\n  \"slotIdentifier\": \"gallery_1\",\n  \"sortOrder\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manage/media/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manage", "media", "confirm"]
            }
          }
        },
        {
          "name": "4. Delete Media dari R2 & DB",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/manage/media/{{mediaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manage", "media", "{{mediaId}}"]
            }
          }
        }
      ]
    }
