          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Publikasi Berhasil & Status Live', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.isPublished).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
